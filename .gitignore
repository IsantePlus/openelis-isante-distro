**/*checksum*.properties
**/*checksums*.properties
configs/openelis/properties/TotalSystemConfiguration.properties
configs/openelis/properties/ChangedSystemConfiguration.properties

# FHIR gateway credentials (generated by scripts/gen-fhir-gateway-htpasswd.sh)
configs/openelis/fhir-gateway/.htpasswd
configs/openelis/fhir-gateway/gateway.env
